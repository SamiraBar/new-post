{
    "name": "codeceptjs-tests",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "codeceptjs": "codeceptjs run --steps",
        "codeceptjs:headless": "HEADLESS=true codeceptjs run --steps",
        "codeceptjs:ui": "codecept-ui --app",
        "codeceptjs:demo": "codeceptjs run --steps -c node_modules/@codeceptjs/examples/codecept.puppeteer.conf.js",
        "codeceptjs:demo:headless": "HEADLESS=true codeceptjs run --steps -c node_modules/@codeceptjs/examples/codecept.puppeteer.conf.js",
        "codeceptjs:demo:ui": "codecept-ui --app  -c node_modules/@codeceptjs/examples/codecept.puppeteer.conf.js",
        "test": "./tests.sh",
        "test:login": "./tests.sh '@login'",
        "test:logout": "./tests.sh '@logout'",
        "test:create": "./tests.sh '@create'",
        "test:update": "./tests.sh '@update'",
        "test:delete": "./tests.sh '@delete'",
        "test:crud": "./tests.sh '@create|@delete|@update'",
        "test:validation": "./tests.sh '@validation'",
        "test:navigation": "./tests.sh '@navigation'",
        "test:i18n": "./tests.sh '@i18n'",
        "test:footer": "./tests.sh '@footer'",
        "test:delivery-calculator": "./tests.sh '@delivery-calculator'",
        "test:tracking": "./tests.sh '@tracking'",
        "test:modal": "./tests.sh '@modal'",
        "test:smoke": "./tests.sh '@smoke'",
        "test:regression": "./tests.sh '@regression'",
      "test:close": "./tests.sh '@close'",
      "test:delivery-type": "./tests.sh '@delivery-type'"
    },
    "devDependencies": {
        "@codeceptjs/configure": "^1.0.6",
        "@codeceptjs/examples": "^1.2.4",
        "@codeceptjs/ui": "^1.3.8",
        "@types/node": "^24.10.1",
        "codeceptjs": "^3.7.5",
        "puppeteer": "^21.1.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
