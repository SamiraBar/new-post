{
    "name": "codeceptjs-tests",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "codeceptjs": "codeceptjs run --steps",
        "codeceptjs:headless": "HEADLESS=true codeceptjs run --steps",
        "codeceptjs:ui": "codecept-ui --app",
        "codeceptjs:demo": "codeceptjs run --steps -c node_modules/@codeceptjs/examples/codecept.puppeteer.conf.js",
        "codeceptjs:demo:headless": "HEADLESS=true codeceptjs run --steps -c node_modules/@codeceptjs/examples/codecept.puppeteer.conf.js",
        "codeceptjs:demo:ui": "codecept-ui --app  -c node_modules/@codeceptjs/examples/codecept.puppeteer.conf.js",
        "test": "node run-tests.mjs",
        "test:all": "node run-tests.mjs",

        "test:login": "node run-tests.mjs @login",
        "test:logout": "node run-tests.mjs @logout",
        "test:create": "node run-tests.mjs @create",
        "test:update": "node run-tests.mjs @update",
        "test:delete": "node run-tests.mjs @delete",

        "test:crud": "node run-tests.mjs \"@create|@delete|@update\"",
        "test:validation": "node run-tests.mjs @validation",
        "test:navigation": "node run-tests.mjs @navigation",
        "test:i18n": "node run-tests.mjs @i18n",
        "test:footer": "node run-tests.mjs @footer",
        "test:delivery-calculator": "node run-tests.mjs @delivery-calculator",
        "test:tracking": "node run-tests.mjs @tracking",
        "test:modal": "node run-tests.mjs @modal",
        "test:smoke": "node run-tests.mjs @smoke",
        "test:regression": "node run-tests.mjs @regression",
        "test:close": "node run-tests.mjs @close",
        "test:delivery-type": "node run-tests.mjs @delivery-type"
    },
    "devDependencies": {
        "@codeceptjs/configure": "^1.0.6",
        "@codeceptjs/examples": "^1.2.4",
        "@codeceptjs/ui": "^1.3.8",
        "@types/node": "^24.10.1",
        "codeceptjs": "^3.7.5",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "puppeteer": "^21.1.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "wait-on": "^9.0.3"
    }
}
