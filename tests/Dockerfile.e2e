# --- stage 1: install deps with Node 22 ---
FROM node:22-bookworm-slim AS deps
WORKDIR /work/tests

COPY package.json package-lock.json ./
RUN npm ci

# --- stage 2: runtime with Chromium deps (puppeteer image) ---
FROM ghcr.io/puppeteer/puppeteer:22.12.1
WORKDIR /work/tests

COPY --from=deps /work/tests/node_modules ./node_modules
COPY --from=deps /work/tests/package.json ./package.json
COPY --from=deps /work/tests/package-lock.json ./package-lock.json

COPY . .

ENV DOCKER_E2E=true
ENV HEADLESS=true
ENV BASE_URL=http://front-test:5183

CMD sh -lc "npx wait-on --timeout 180000 --interval 500 $BASE_URL && npm run test"
